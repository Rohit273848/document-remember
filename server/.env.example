NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=family_session
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=15

# Cloudinary (Required for secure document storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional for local test, Recommended for production reminders & password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Family Documents <no-reply@example.com>
